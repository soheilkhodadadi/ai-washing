# Copy to .env for local use if desired. Do not commit .env.
AIW_REPO_ROOT=/path/to/ai-washing
AIW_DATA_ROOT=/path/to/ai-washing-private-data
AIW_OUTPUT_ROOT=/path/to/ai-washing/outputs/reproduced
AIW_PAPER_ROOT=/path/to/ai-washing/outputs/paper_exports
# Optional WRDS refresh settings for local-only pulls. Never commit real credentials.
WRDS_USER=your_wrds_username
WRDS_PASS=your_wrds_password
WRDS_DB_HOST=wrds-pgdata.wharton.upenn.edu
WRDS_DB_PORT=9737

# Optional explicit T25 cache path, normally staged under AIW_DATA_ROOT.
AIW_T25_EXECUCOMP_CACHE=/path/to/ai-washing-private-data/external/execucomp/execucomp_ceo_anncomp_2015_2024.parquet
